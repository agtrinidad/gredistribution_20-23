        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Shape' />
            <encodings>
              <color column='[federated.18urrl71mhk9v21c7v66k1syyzmr].[usr:Calculation_1643813929597796355:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontsize='8'>GRE® General Test Interpretive Data by Broad Graduate Major Field</run>
                <run>Æ&#10;</run>
                <run fontcolor='#d9d6d1' fontsize='8'>⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontsize='8'>This tool intends to showcase ETS-provided score distributions in an intuitive and accessible way.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontsize='8'>Adapted from Table 3A provided by ETS, covering July 1, 2020 to June 30, 2023. Retrieved September 2024.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#1b1b1b' fontsize='8'>Intended Graduate Major: </run>
                <run fontcolor='#1b1b1b' fontsize='8'>View statistics relevant to a particular graduate major.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#1b1b1b' fontsize='8'>Major Comparison:</run>
                <run fontcolor='#1b1b1b' fontsize='8'> Compare distributions between two given graduate majors.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#1b1b1b' fontsize='8'>User Comparison: </run>
                <run fontcolor='#1b1b1b' fontsize='8'>Compare user-provided scores to a given major&apos;s average.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#d9d6d1' fontsize='8'>⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#1b1b1b' fontsize='8'>GRAND TOTAL</run>
                <run fontcolor='#1b1b1b' fontsize='8'> data were calculated using the original dataset, excluding </run>
                <run bold='true' fontcolor='#1b1b1b' fontsize='8'>60: Other Fields, Other*</run>
                <run fontcolor='#1b1b1b' fontsize='8'> as this category&apos;s distribution was left unprovided by ETS. This may result in minor discrepancies from ETS-released population means. </run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#1b1b1b' fontsize='8'>Please note that ETS-provided distributions only represent test takers that indicated an intended graduate major during testing. This will cause significant discrepancies in variance when compared to population data</run>
                <run bold='true' fontcolor='#1b1b1b' fontsize='8'>.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#1b1b1b' fontsize='8'>An </run>
                <run bold='true' fontcolor='#1b1b1b' fontsize='8'>ETS-Provided Population </run>
                <run fontcolor='#1b1b1b' fontsize='8'>option</run>
                <run bold='true' fontcolor='#1b1b1b' fontsize='8'>, adapted from Table 1A</run>
                <run fontcolor='#1b1b1b' fontsize='8'>  is provided in order to solve for this. Because ETS does not provide distributions for this, nor the </run>
                <run bold='true' fontcolor='#1b1b1b' fontsize='8'>OTHER FIELDS</run>
                <run fontcolor='#1b1b1b' fontsize='8'> categories,</run>
                <run fontcolor='#1b1b1b' fontsize='8' italic='true'> their distributions are zeroed out.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#d9d6d1' fontname='Google Sans' fontsize='8'>⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontsize='8' italic='true'>A continuation of a project on my GitHub:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontsize='8' italic='true'>https://github.com/agtrinidad/gredistribution_20-23</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='shape' value='Custom Shapes/Info2.png' />
                <format attr='mark-color' value='#8cd17d' />
              </style-rule>
